# Copia este archivo como .env en apps/backend y sustituye los valores de ejemplo.
# Supabase Postgres es la base compartida del proyecto. Usa la cadena de conexión
# del entorno de desarrollo correspondiente; no pegues credenciales reales aquí.
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:5432/postgres?schema=public"

# Datos del proyecto Supabase. La secret key se usa solo en el backend.
SUPABASE_URL="https://TU_PROYECTO.supabase.co"
SUPABASE_SECRET_KEY="TU_CLAVE_SECRETA_DE_SERVIDOR"
SUPABASE_JWKS_URL="https://TU_PROYECTO.supabase.co/auth/v1/.well-known/jwks.json"

PORT=3000
