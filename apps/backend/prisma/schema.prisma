// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MexicoState {
  AGUASCALIENTES
  BAJA_CALIFORNIA
  BAJA_CALIFORNIA_SUR
  CAMPECHE
  CHIAPAS
  CHIHUAHUA
  CIUDAD_DE_MEXICO
  COAHUILA
  COLIMA
  DURANGO
  GUANAJUATO
  GUERRERO
  HIDALGO
  JALISCO
  MEXICO
  MICHOACAN
  MORELOS
  NAYARIT
  NUEVO_LEON
  OAXACA
  PUEBLA
  QUERETARO
  QUINTANA_ROO
  SAN_LUIS_POTOSI
  SINALOA
  SONORA
  TABASCO
  TAMAULIPAS
  TLAXCALA
  VERACRUZ
  YUCATAN
  ZACATECAS
}

enum CommunityRol {
  ADMIN
  MODERATOR
  MEMBER
}

enum PostType {
  GENERAL
  TIP
  QUESTION
  LOST_PET
  HELP
}

model User {
  id          String            @id
  email       String            @unique
  username    String            @unique
  avatar      String?
  bio         String?
  createdAt   DateTime          @default(now())
  isActive    Boolean           @default(true)
  locatedAt   MexicoState
  pets        Pet[]
  posts       Post[]
  comments    Comment[]
  postLikes   PostLike[]
  communities CommunityMember[]
  postView PostView[]
  moderationActions ModerationRemoval[] @relation("RemovalModerator")
  moderationRestorations ModerationRemoval[] @relation("RemovalRestorer")
  communityExpulsions CommunityExpulsion[] @relation("ExpelledUser")
  communityExpulsionActions CommunityExpulsion[] @relation("ExpulsionActor")
  eventsCreated Event[] @relation("EventCreator")
  eventAttendances EventAttendance[]
  eventNotices EventNotice[]
  conversationsAsA Conversation[] @relation("ConversationUserA")
  conversationsAsB Conversation[] @relation("ConversationUserB")
  chatParticipations ConversationParticipant[]
  messagesSent Message[]
  chatBlocksGiven ChatBlock[] @relation("ChatBlocker")
  chatBlocksReceived ChatBlock[] @relation("ChatBlocked")
  chatReportsFiled ChatReport[] @relation("ChatReporter")
  chatReportsReceived ChatReport[] @relation("ChatReported")
  adoptionListings AdoptionListing[]
  adoptionReports AdoptionReport[]
}

model Pet {
  id         Int     @id @default(autoincrement())
  owner      User    @relation(fields: [ownerId], references: [id])
  ownerId    String
  name       String
  species    String
  breed      String
  birthYear  Int
  birthMonth Int
  birthDay   Int?
  photo      String?
  bio        String?
  isActive   Boolean @default(true)
  posts Post[]
  adoptionListings AdoptionListing[]

  @@index([ownerId, id])
}

model Post {
  id          Int        @id @default(autoincrement())
  user        User       @relation(fields: [userId], references: [id])
  userId      String
  communityId Int?
  community   Community? @relation(fields: [communityId], references: [id])
  petId       Int?
  pet         Pet?       @relation(fields: [petId], references: [id])
  type        PostType   @default(GENERAL)
  title       String
  description String
  createdAt   DateTime   @default(now())
  isActive    Boolean    @default(true)
  photoUrl    String?
  comments    Comment[]
  likes       PostLike[]
  views PostView[]
  moderationRemovals ModerationRemoval[]

  @@index([petId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editedAt  DateTime?
  isActive  Boolean  @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  postId Int
  post   Post @relation(fields: [postId], references: [id])

  @@index([postId, createdAt])
  @@index([userId])
  moderationRemovals ModerationRemoval[]
}

// Motivos cerrados al retirar contenido de una comunidad (D-140).
enum RemovalReason {
  SPAM
  OFFENSIVE
  HARASSMENT
  OFF_TOPIC
  FALSE_INFO
  OTHER
}

model ModerationRemoval {
  id           Int       @id @default(autoincrement())
  // Nula en ocultaciones de publicación general (D-56); obligatoria en retiradas comunitarias.
  reason       RemovalReason?
  note         String?   @db.VarChar(200)
  // Fecha en que el autor pulsó «Entendido»; nula = aviso pendiente (D-142).
  acknowledgedAt DateTime?
  postId       Int?
  post         Post?     @relation(fields: [postId], references: [id], onDelete: Restrict)
  commentId    Int?
  comment      Comment?  @relation(fields: [commentId], references: [id], onDelete: Restrict)
  moderatorId  String
  moderator    User      @relation("RemovalModerator", fields: [moderatorId], references: [id])
  removedAt    DateTime  @default(now())
  restoredAt   DateTime?
  restoredById String?
  restoredBy   User?     @relation("RemovalRestorer", fields: [restoredById], references: [id], onDelete: Restrict)

  @@index([postId])
  @@index([commentId])
  @@index([moderatorId])
  @@index([restoredById])
  @@index([acknowledgedAt])
}

model PostLike {
  userId    String
  postId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@id([userId, postId])
  @@index([postId])
}
model PostView {
    userId   String
    postId   Int
    viewedAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id])
    post Post @relation(fields: [postId], references: [id])

    @@id([userId, postId])
    @@index([userId, viewedAt])
    @@index([postId])
  }

model Community {
  id          Int               @id @default(autoincrement())
  name        String
  description String
  topic       String
  photoUrl    String?
  members     CommunityMember[]
  posts       Post[]
  expulsions  CommunityExpulsion[]
  events      Event[]
}

model CommunityMember {
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  communityId Int
  community   Community    @relation(fields: [communityId], references: [id])
  role        CommunityRol
  joinedAt    DateTime     @default(now())

  @@id([userId, communityId])
  @@index([communityId, joinedAt, userId])
}

model CommunityExpulsion {
  communityId Int
  userId String
  expelledById String
  expelledAt DateTime @default(now())
  community Community @relation(fields: [communityId], references: [id])
  user User @relation("ExpelledUser", fields: [userId], references: [id])
  expelledBy User @relation("ExpulsionActor", fields: [expelledById], references: [id])

  @@id([communityId, userId])
  @@index([userId, communityId])
}

// Eventos de comunidad (D-115, D-116; plan de Eventos). Un evento pertenece
// siempre a una comunidad (D-144) y se elimina con ella.
enum EventStatus {
  PUBLISHED
  CANCELLED
}

enum EventAttendanceStatus {
  GOING
  NOT_GOING
}

// Avisos a quienes mantienen «Iré» (D-101): cambio de horario o lugar, o cancelación.
enum EventNoticeKind {
  CHANGED
  CANCELLED
}

model Event {
  id                    Int               @id @default(autoincrement())
  communityId           Int
  community             Community         @relation(fields: [communityId], references: [id])
  creatorId             String
  creator               User              @relation("EventCreator", fields: [creatorId], references: [id])
  title                 String            @db.VarChar(120)
  description           String            @db.VarChar(3000)
  placeLabel            String            @db.VarChar(200)
  latitude              Decimal           @db.Decimal(9, 6)
  longitude             Decimal           @db.Decimal(9, 6)
  startsAt              DateTime
  endsAt                DateTime
  timeZone              String            @db.VarChar(64)
  // Referencia interna en Storage privado; nunca una URL pública (D-102).
  coverImagePath        String?
  status                EventStatus       @default(PUBLISHED)
  // Total de «Iré» vigentes fijado una sola vez al comenzar (D-109).
  confirmedCountAtStart Int?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  attendances           EventAttendance[]
  notices               EventNotice[]

  @@index([communityId, status, startsAt, id])
  @@index([communityId, status, endsAt, id])
  @@index([status, startsAt])
}

model EventAttendance {
  eventId       Int
  event         Event                 @relation(fields: [eventId], references: [id])
  userId        String
  user          User                  @relation(fields: [userId], references: [id])
  status        EventAttendanceStatus
  respondedAt   DateTime
  // Fecha en que dejó de valer por salir, ser expulsada o desactivar la cuenta (D-71, D-117).
  invalidatedAt DateTime?

  @@id([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
}

model EventNotice {
  id          Int             @id @default(autoincrement())
  eventId     Int
  event       Event           @relation(fields: [eventId], references: [id])
  recipientId String
  recipient   User            @relation(fields: [recipientId], references: [id])
  kind        EventNoticeKind
  summary     String          @db.VarChar(300)
  createdAt   DateTime        @default(now())
  readAt      DateTime?
  pushSentAt  DateTime?
  changeKey   String          @db.VarChar(120)

  @@unique([recipientId, changeKey])
  @@index([recipientId, createdAt, id])
  @@index([eventId])
}

// Chat privado uno a uno (D-75–D-77, D-79, D-81–D-83, D-87–D-88, D-145–D-146).
// Un solo chat por pareja: userAId < userBId (orden de texto), con unicidad.
model Conversation {
  id            Int                       @id @default(autoincrement())
  userAId       String
  userA         User                      @relation("ConversationUserA", fields: [userAId], references: [id])
  userBId       String
  userB         User                      @relation("ConversationUserB", fields: [userBId], references: [id])
  createdAt     DateTime                  @default(now())
  // Fecha del último mensaje; ordena la bandeja. null si aún no hay mensajes.
  lastMessageAt DateTime?
  participants  ConversationParticipant[]
  messages      Message[]
  reports       ChatReport[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

// Estado propio de cada participante; no cambia lo que ve la otra persona.
model ConversationParticipant {
  conversationId          Int
  conversation            Conversation @relation(fields: [conversationId], references: [id])
  userId                  String
  user                    User         @relation(fields: [userId], references: [id])
  // Último mensaje de la otra persona que se mostró en pantalla («Leído», D-81).
  lastReadMessageId       Int?
  // «Ocultar chat» o «Borrar chat para mí»; un mensaje nuevo lo vuelve null (D-79).
  hiddenAt                DateTime?
  // «Borrar chat para mí»: mensajes con id <= este valor dejan de verse para siempre (D-82).
  clearedThroughMessageId Int?

  @@id([conversationId, userId])
  @@index([userId, hiddenAt])
}

model Message {
  id             Int                 @id @default(autoincrement())
  conversationId Int
  conversation   Conversation        @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User                @relation(fields: [senderId], references: [id])
  body           String              @db.VarChar(250)
  // Identificador que manda la app para que un reintento no duplique el mensaje.
  clientKey      String              @db.VarChar(64)
  createdAt      DateTime            @default(now())
  reports        ChatReportMessage[]

  @@unique([senderId, clientKey])
  @@index([conversationId, id])
}

// Quién bloqueó a quién (D-76): cualquier bloqueo detiene los envíos en ambos sentidos.
model ChatBlock {
  blockerId String
  blocker   User     @relation("ChatBlocker", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("ChatBlocked", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// «Reportar conversación» (CH-T09; D-77, D-86–D-88, D-146). Se guarda en el MVP
// sin lectura del equipo ni estados de revisión; los mensajes se referencian,
// no se copian, y se conservan hasta la revisión en la futura web.
model ChatReport {
  id             Int                 @id @default(autoincrement())
  conversationId Int
  conversation   Conversation        @relation(fields: [conversationId], references: [id])
  reporterId     String
  reporter       User                @relation("ChatReporter", fields: [reporterId], references: [id])
  reportedUserId String
  reportedUser   User                @relation("ChatReported", fields: [reportedUserId], references: [id])
  note           String?             @db.VarChar(500)
  // Clave que manda la app para que un reintento no guarde dos reportes.
  clientKey      String              @db.VarChar(64)
  createdAt      DateTime            @default(now())
  messages       ChatReportMessage[]

  @@unique([reporterId, clientKey])
  @@index([conversationId])
  @@index([reportedUserId])
}

model ChatReportMessage {
  reportId  Int
  report    ChatReport @relation(fields: [reportId], references: [id])
  messageId Int
  // Restrict: un mensaje reportado no se puede borrar físicamente (D-88).
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@id([reportId, messageId])
  @@index([messageId])
}

// Adopción (AD-T02, D-89–D-98): tablas propias, separadas de Post, para que los
// anuncios no entren en Inicio ni en comunidades ni acepten comentarios o «Me gusta».
// El orden del enum importa: las listas muestran primero SEEKING_HOME.
enum AdoptionStatus {
  SEEKING_HOME
  FOUND_HOME
}

enum AdoptionReportReason {
  POSSIBLE_SALE
  MISLEADING_INFO
  INAPPROPRIATE_CONTENT
  OTHER
}

model AdoptionListing {
  id          Int            @id @default(autoincrement())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  title       String         @db.VarChar(120)
  description String         @db.VarChar(3000)
  status      AdoptionStatus @default(SEEKING_HOME)
  petId       Int?
  pet         Pet?           @relation(fields: [petId], references: [id])
  // false = retirado por su autor; conserva el estado para restaurarlo (D-94).
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  photos      AdoptionPhoto[]
  reports     AdoptionReport[]

  @@index([isActive, status, id])
  @@index([userId, isActive, id])
}

model AdoptionPhoto {
  id         Int             @id @default(autoincrement())
  listingId  Int
  listing    AdoptionListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  // Ruta interna del bucket privado; nunca se devuelve a la app.
  storageKey String
  position   Int
  createdAt  DateTime        @default(now())

  @@unique([listingId, position])
  @@index([listingId])
}

model AdoptionReport {
  id                  Int                  @id @default(autoincrement())
  listingId           Int
  listing             AdoptionListing      @relation(fields: [listingId], references: [id], onDelete: Restrict)
  reporterId          String
  reporter            User                 @relation(fields: [reporterId], references: [id])
  reason              AdoptionReportReason
  explanation         String?              @db.VarChar(500)
  // Copia de lo que decía el anuncio al reportarlo (D-98).
  snapshotTitle       String               @db.VarChar(120)
  snapshotDescription String               @db.VarChar(3000)
  snapshotStatus      AdoptionStatus
  createdAt           DateTime             @default(now())
  photos              AdoptionReportPhoto[]

  @@unique([listingId, reporterId])
  @@index([listingId, createdAt])
}

model AdoptionReportPhoto {
  id         Int            @id @default(autoincrement())
  reportId   Int
  report     AdoptionReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  storageKey String
  position   Int

  @@unique([reportId, position])
  @@index([reportId])
  @@index([storageKey])
}
