// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MexicoState {
  AGUASCALIENTES
  BAJA_CALIFORNIA
  BAJA_CALIFORNIA_SUR
  CAMPECHE
  CHIAPAS
  CHIHUAHUA
  CIUDAD_DE_MEXICO
  COAHUILA
  COLIMA
  DURANGO
  GUANAJUATO
  GUERRERO
  HIDALGO
  JALISCO
  MEXICO
  MICHOACAN
  MORELOS
  NAYARIT
  NUEVO_LEON
  OAXACA
  PUEBLA
  QUERETARO
  QUINTANA_ROO
  SAN_LUIS_POTOSI
  SINALOA
  SONORA
  TABASCO
  TAMAULIPAS
  TLAXCALA
  VERACRUZ
  YUCATAN
  ZACATECAS
}

enum CommunityRol {
  ADMIN
  MODERATOR
  MEMBER
}

enum PostType {
  GENERAL
  TIP
  QUESTION
  LOST_PET
  HELP
}

model User {
  id          String            @id
  email       String            @unique
  username    String            @unique
  avatar      String?
  bio         String?
  createdAt   DateTime          @default(now())
  isActive    Boolean           @default(true)
  locatedAt   MexicoState
  pets        Pet[]
  posts       Post[]
  comments    Comment[]
  postLikes   PostLike[]
  communities CommunityMember[]
  postView PostView[]
  moderationActions ModerationRemoval[] @relation("RemovalModerator")
  moderationRestorations ModerationRemoval[] @relation("RemovalRestorer")
  communityExpulsions CommunityExpulsion[] @relation("ExpelledUser")
  communityExpulsionActions CommunityExpulsion[] @relation("ExpulsionActor")
}

model Pet {
  id         Int     @id @default(autoincrement())
  owner      User    @relation(fields: [ownerId], references: [id])
  ownerId    String
  name       String
  species    String
  breed      String
  birthYear  Int
  birthMonth Int
  birthDay   Int?
  photo      String?
  bio        String?
  isActive   Boolean @default(true)
  posts Post[]

  @@index([ownerId, id])
}

model Post {
  id          Int        @id @default(autoincrement())
  user        User       @relation(fields: [userId], references: [id])
  userId      String
  communityId Int?
  community   Community? @relation(fields: [communityId], references: [id])
  petId       Int?
  pet         Pet?       @relation(fields: [petId], references: [id])
  type        PostType   @default(GENERAL)
  title       String
  description String
  createdAt   DateTime   @default(now())
  isActive    Boolean    @default(true)
  photoUrl    String?
  comments    Comment[]
  likes       PostLike[]
  views PostView[]
  moderationRemovals ModerationRemoval[]

  @@index([petId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editedAt  DateTime?
  isActive  Boolean  @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  postId Int
  post   Post @relation(fields: [postId], references: [id])

  @@index([postId, createdAt])
  @@index([userId])
  moderationRemovals ModerationRemoval[]
}

// Motivos cerrados al retirar contenido de una comunidad (D-140).
enum RemovalReason {
  SPAM
  OFFENSIVE
  HARASSMENT
  OFF_TOPIC
  FALSE_INFO
  OTHER
}

model ModerationRemoval {
  id           Int       @id @default(autoincrement())
  // Nula en ocultaciones de publicación general (D-56); obligatoria en retiradas comunitarias.
  reason       RemovalReason?
  note         String?   @db.VarChar(200)
  // Fecha en que el autor pulsó «Entendido»; nula = aviso pendiente (D-142).
  acknowledgedAt DateTime?
  postId       Int?
  post         Post?     @relation(fields: [postId], references: [id], onDelete: Restrict)
  commentId    Int?
  comment      Comment?  @relation(fields: [commentId], references: [id], onDelete: Restrict)
  moderatorId  String
  moderator    User      @relation("RemovalModerator", fields: [moderatorId], references: [id])
  removedAt    DateTime  @default(now())
  restoredAt   DateTime?
  restoredById String?
  restoredBy   User?     @relation("RemovalRestorer", fields: [restoredById], references: [id], onDelete: Restrict)

  @@index([postId])
  @@index([commentId])
  @@index([moderatorId])
  @@index([restoredById])
  @@index([acknowledgedAt])
}

model PostLike {
  userId    String
  postId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@id([userId, postId])
  @@index([postId])
}
model PostView {
    userId   String
    postId   Int
    viewedAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id])
    post Post @relation(fields: [postId], references: [id])

    @@id([userId, postId])
    @@index([userId, viewedAt])
    @@index([postId])
  }

model Community {
  id          Int               @id @default(autoincrement())
  name        String
  description String
  topic       String
  photoUrl    String?
  members     CommunityMember[]
  posts       Post[]
  expulsions  CommunityExpulsion[]
}

model CommunityMember {
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  communityId Int
  community   Community    @relation(fields: [communityId], references: [id])
  role        CommunityRol
  joinedAt    DateTime     @default(now())

  @@id([userId, communityId])
  @@index([communityId, joinedAt, userId])
}

model CommunityExpulsion {
  communityId Int
  userId String
  expelledById String
  expelledAt DateTime @default(now())
  community Community @relation(fields: [communityId], references: [id])
  user User @relation("ExpelledUser", fields: [userId], references: [id])
  expelledBy User @relation("ExpulsionActor", fields: [expelledById], references: [id])

  @@id([communityId, userId])
  @@index([userId, communityId])
}
