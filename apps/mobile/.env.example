# Dirección de la API alcanzable desde el dispositivo o emulador.
# En un teléfono físico, sustituye localhost por la IP local del equipo.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Solo para compilar un binario Android fuera de Expo Go. Restringir por paquete y SHA-1.
# Configura la clave en el entorno de compilación; no es un secreto de servidor.
GOOGLE_MAPS_API_KEY=
