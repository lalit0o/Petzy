{
  "name": "proyecto-aplicaciones-moviles",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "backend": "pnpm --filter proyecto-backend start:dev",
    "backend:build": "pnpm --filter proyecto-backend build",
    "mobile": "pnpm --filter mobile start",
    "dev": "concurrently -n backend,mobile -c blue,green \"pnpm backend\" \"pnpm mobile\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
